images {
  image: "/assets/terrain_stone_horizontal_middle.png"
  sprite_trim_mode: SPRITE_TRIM_MODE_OFF
}
animations {
  id: "idle"
  images {
    image: "/assets/terrain_stone_horizontal_middle.png"
    sprite_trim_mode: SPRITE_TRIM_MODE_OFF
  }
  playback: PLAYBACK_LOOP_FORWARD
  fps: 60
  flip_horizontal: 0
  flip_vertical: 0
}
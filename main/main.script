local state = require "main.state"

local function spawn_level(self)
    -- collectionfactory.create returns a table of { [path_hash] = game_object_id }
    self.level_objects = collectionfactory.create("#level_factory")
end

function init(self)
    msg.post(".", "acquire_input_focus")
    spawn_level(self)
    print("Game Manager initialized.")
end

function on_message(self, message_id, message, sender)
    if message_id == hash("player_died") then
        print("Manager: Handling player death...")
        state.game_started = false

        -- 1. Thoroughly wipe every game object instance belonging to the level
        if self.level_objects then
            for _, id in pairs(self.level_objects) do
                if go.exists(id) then
                    go.delete(id)
                end
            end
            self.level_objects = nil
        end

        -- 2. Spawn a fresh, pristine copy of level_1.collection
        spawn_level(self)

        -- 3. Tell the player to reset itself back to start
        msg.post("/player#script", "reset_player")
    end
end
function init(self)
    self.timer = 0
    self.spawn_interval = 1.8 -- Time in seconds between obstacles
end

function update(self, dt)
    self.timer = self.timer + dt
    if self.timer >= self.spawn_interval then
        self.timer = 0
        
        -- Spawn at the right edge of the screen at floor height (y = 116)
        local spawn_pos = vmath.vector3(1350, 116, 0)
        factory.create("#spike_factory", spawn_pos)
    end
end
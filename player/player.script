local GRAVITY = -1200
local JUMP_FORCE = 650

function init(self)
    msg.post(".", "acquire_input_focus")
    self.velocity = vmath.vector3(0, 0, 0)
    self.is_grounded = false
    print("Task 1 Complete: Player loaded successfully. Initializing Task 2: Movement & Jump.")
end

function update(self, dt)
    -- Apply gravity if not grounded
    if not self.is_grounded then
        self.velocity.y = self.velocity.y + (GRAVITY * dt)
    end

    -- Move the player position based on velocity
    local pos = go.get_position()
    pos.y = pos.y + (self.velocity.y * dt)
    
    -- Temporary floor constraint for testing jump mechanics
    if pos.y <= 100 then
        pos.y = 100
        self.velocity.y = 0
        self.is_grounded = true
    end
    
    go.set_position(pos)
end

function on_input(self, action_id, action)
    if action_id == hash("jump") and action.pressed and self.is_grounded then
        self.velocity.y = JUMP_FORCE
        self.is_grounded = false
    end
end